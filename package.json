{
  "name": "aed-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "vite preview --config 打包发布配置.ts",
    "dev": "vite --config 打包发布配置.ts",
    "build:pages": "vite build --config 打包发布配置.ts",
    "preview": "vite preview --config 打包发布配置.ts",
    "test": "node --test 开发辅助文件-不影响网站/自动测试脚本/rendered-html.test.mjs",
    "lint": "eslint . --config 开发辅助文件-不影响网站/代码检查规则/eslint.config.mjs --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate --config 开发辅助文件-不影响网站/数据库相关-网站用不到/drizzle.config.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
